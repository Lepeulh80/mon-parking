# LOCAL : copier ce fichier en .env. npm start/auth:setup/deploy:check le lisent.
# Pour Internet : utiliser .env.production.example et renseigner le vrai domaine HTTPS.
NODE_ENV=development
AUTH_ORIGIN=http://127.0.0.1:3000
HOST=127.0.0.1
PORT=3000
AUTH_DB=.server-data/auth.sqlite
# Limitation de débit de la connexion (M6) : seuil par origine réseau.
# AUTH_MAX_LOGIN_ATTEMPTS=20
# Mettre 1 UNIQUEMENT derrière un reverse proxy de confiance : la limitation
# utilise alors X-Forwarded-For au lieu de l'adresse du socket.
# AUTH_TRUST_PROXY=1
# DIST_DIR=dist
# AUTH_TLS_CERT=/chemin/hors-dist/certificat.pem
# AUTH_TLS_KEY=/chemin/hors-dist/cle-privee.key

# Supabase: clé publique uniquement, jamais service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# UUID du parking distant (lots.id); optionnel, configurable dans l'interface.
VITE_SUPABASE_OCR_LOT_ID=

# Optional external BFF (must implement OAuth consent, WebAuthn validation and push).
# No bank password, refresh token or provider secret may be placed in VITE_*.
VITE_INTEGRATION_BFF_URL=
VITE_VAPID_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Double authentification (TOTP)
# ---------------------------------------------------------------------------
# off (défaut) | admin | all
# La politique n'empêche jamais la connexion : elle expose `mfa.required` pour
# que l'interface impose l'enrôlement (sinon un admin non enrôlé se verrouille).
AUTH_2FA_POLICY=off
# Clé de scellement des secrets TOTP (32 octets en base64, ex. openssl rand -base64 32).
# Si absente : un fichier auth-store.key (0600) est généré à côté de AUTH_DB.
# ATTENTION : perdre cette clé oblige à réenrôler tous les authentificateurs.
AUTH_2FA_KEY=

# 1 = refuse les hachages PIN hérités (sha256×3, FNV). À activer une fois que
# tous les comptes se sont reconnectés au moins une fois depuis la v15.
AUTH_DENY_LEGACY_PIN=0
