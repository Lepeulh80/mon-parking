# MON PARKING — connexion Neon. Copier en .env, remplir, ne JAMAIS committer.
# 1) Service Render / serveur : l'URL POOLER (obligatoire, plan gratuit Neon).
DATABASE_URL=postgresql://USER:MOT_DE_PASSE@ep-xxxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# 2) Migrations (DDL refusé par PgBouncer) : la même URL SANS « -pooler ».
DATABASE_DIRECT_URL=postgresql://USER:MOT_DE_PASSE@ep-xxxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# 3) Le service ne fait pas de DDL au démarrage derrière un pooler.
PG_AUTO_MIGRATE=0
# 4) Clé de scellement des secrets TOTP : générer UNE fois et conserver.
#    node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_2FA_KEY=
# 5) Amorce du premier administrateur (uniquement si la base est vide).
ADMIN_USERNAME=admin
ADMIN_PIN=1234
ADMIN_LOT_NAME=Auto Prestige
ADMIN_NAME=Kouadio Yao
