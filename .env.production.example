# Copier en .env et remplacer le domaine par le domaine réel avant démarrage.
NODE_ENV=production
AUTH_ORIGIN=https://parking.example.com
# 0.0.0.0 en conteneur (Render, Koyeb, Docker) ; 127.0.0.1 derriere Caddy sur un VPS.
HOST=127.0.0.1
PORT=3000
# Répertoire persistant, hors dist. Propriétaire : utilisateur du service Node.
AUTH_DB=/var/lib/mon-parking/auth.sqlite
DIST_DIR=dist
# Limitation de débit de la connexion (défaut : 20 tentatives / 15 minutes).
# AUTH_MAX_LOGIN_ATTEMPTS=20
# Derrière Caddy/Nginx, mettre 1 pour compter par client réel (X-Forwarded-For).
AUTH_TRUST_PROXY=1
# TLS est normalement assuré par Caddy/Nginx devant Node.
# Sinon fournir ces DEUX fichiers privés, hors dist :
# AUTH_TLS_CERT=/etc/mon-parking/tls/fullchain.pem
# AUTH_TLS_KEY=/etc/mon-parking/tls/privkey.key
# Valeurs publiques Supabase uniquement, si cette intégration est activée.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_OCR_LOT_ID=
VITE_INTEGRATION_BFF_URL=
VITE_VAPID_PUBLIC_KEY=

# --- Cloudflare R2 (photos des véhicules) -----------------------------------
# Espace de stockage compatible S3 : le navigateur reçoit une URL PUT présignée,
# le secret ne quitte jamais le serveur. Sans ces quatre valeurs, l'application
# fonctionne normalement et garde les photos en local (IndexedDB).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Domaine public de lecture (r2.dev ou domaine personnalisé), sans « / » final.
R2_PUBLIC_URL=
